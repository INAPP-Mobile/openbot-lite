# =============================================================================
# OpenBot Lite — Environment Variables
#
# OpenBot (CopilotKit) is an open-source AI-coworker runtime. This "Lite"
# template ships ONE container: the AG-UI protocol server + web UI + built-in
# agent runtime ("computers" with a bundled Chromium) + embedded Postgres 16
# (pgvector), with a credential vault, audit trail, and per-agent workspaces
# on persistent volumes.
#
# The server refuses to start without a CopilotKit Intelligence project
# (durable threads / memory) AND a model key for the built-in bots.
# Managed Intelligence is a CopilotKit cloud service (the "Pro" plan);
# self-hosting the Intelligence platform is an Enterprise (Helm) feature.
#
# Macro syntax (${{...}}) is only interpreted by the Railway template deploy
# form — for local `docker run` use real values.
# =============================================================================

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
PORT=3001
# Keep in sync with PORT (read by the startup proxy check).
SERVER_PORT=3001

# ---------------------------------------------------------------------------
# CopilotKit Intelligence (REQUIRED — the server refuses to start without it)
# The two URLs point at the managed service and stay unchanged. Get the
# project runtime key (cpk-...) at https://intelligence.copilotkit.ai
# (API Keys), or via the CLI:
#   npx --yes copilotkit@latest login
#   npx --yes copilotkit@latest project select
# ---------------------------------------------------------------------------
INTELLIGENCE_API_URL=https://api.intelligence.copilotkit.ai
INTELLIGENCE_GATEWAY_WS_URL=wss://realtime.intelligence.copilotkit.ai
INTELLIGENCE_API_KEY=cpk-...

# ---------------------------------------------------------------------------
# Model (REQUIRED for the built-in bots)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
# Optional: OpenAI-compatible endpoint (vLLM, Ollama, LiteLLM).
# OPENAI_BASE_URL=
# Optional model override (defaults per provider: gpt-5.5, claude-sonnet-4-5,
# gemini-2.5-flash).
# BOT_MODEL=gpt-5.5

# ---------------------------------------------------------------------------
# Sign-in (pick one posture)
#
# A) Private desk — DEFAULT. Every visitor is the administrator; the entrypoint
#    shim enforces a loopback trusted-origin so the app's single-user safety
#    gate (declared addresses must not be publicly reachable) always passes.
#    No extra vars needed.
#
# B) Shared domain. Configure ONE provider (Google / Microsoft Entra / Okta)
#    below, then the shim serves at your public domain, turns single-user off,
#    and (if you didn't set one) mints a session-cookie secret:
#    BETTER_AUTH_SECRET=<openssl rand -base64 32 — 32+ chars>
#    INITIAL_ADMIN_EMAILS=admin@example.com
#    Note: without BETTER_AUTH_SECRET set at deploy time the session-cookies
#    won't be signable — set it before the first SSO sign-in.
#
# Google — redirect URI: https://YOUR-DOMAIN/api/auth/callback/google
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Microsoft Entra (default tenant "common" admits personal accounts too)
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_TENANT_ID=common
# Okta — issuer must name YOUR Okta
# OKTA_OAUTH_CLIENT_ID=
# OKTA_OAUTH_CLIENT_SECRET=
# OKTA_OAUTH_ISSUER=https://example.okta.com/oauth2/default
#
# Do NOT set TRUSTED_ORIGINS yourself: the shim derives it. A public
# placeholder there crash-loops single-user mode (the app classifies
# unparseable/unknown origins as public and refuses to start).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# External agent harness (optional) — LangGraph / Mastra / CrewAI
# When MANAGED_AGENT_AG_UI_URL is set, MANAGED_AGENT_TOKEN is required.
# AGENT_TOOL_TOKEN is the secret a bot presents when calling tools back
# through this server.
# MANAGED_AGENT_AG_UI_URL=https://your-harness.example/ag-ui
# MANAGED_AGENT_TOKEN=
# AGENT_TOOL_TOKEN=

# ---------------------------------------------------------------------------
# Retention & tuning (optional)
# ---------------------------------------------------------------------------
# Audit trail is append-only — this is the only way it ever shrinks.
# AUDIT_RETENTION_DAYS=365
# MAX_BOTS limits how many bots one deployment can hold (default unlimited).
# MAX_BOTS=3
# How long a bot stream may say nothing before the turn is given up (ms).
# AGENT_STALL_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Auto-managed (do NOT set unless you know why)
# ---------------------------------------------------------------------------
# KEY_ENCRYPTION_KEY — credential-vault encryption key. The entrypoint shim
#                       generates one on first boot and persists it on the
#                       /var/lib/postgresql volume, so a redeploy never
#                       corrupts the vault. Override only with a base64
#                       32-byte key you manage.
# DATABASE_URL       — embedded Postgres (postgres://openbot@127.0.0.1:5432/openbot)
# EMBEDDED_POSTGRES  — "on" (no companion database service)
