{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "startupTimeout": 180
  },
  "volumes": {
    "openbot-data": {
      "mountPath": "/var/lib/postgresql",
      "size": 10
    },
    "openbot-workspace": {
      "mountPath": "/workspace",
      "size": 5
    },
    "openbot-profiles": {
      "mountPath": "/profiles",
      "size": 5
    }
  }
}
